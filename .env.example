# Anthropic LLM — Haiku for cost; only override OPERATOR_MODEL if needed
ANTHROPIC_API_KEY=
OPERATOR_MODEL=claude-haiku-5-5

# AcmeCorp Procure portal (P1+)
PORTAL_OPERATOR_PASSWORD=change-me
PORTAL_MANAGER_PASSWORD=priya-approve
PORTAL_BASE_URL=http://127.0.0.1:8765
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8765
PORTAL_DB_PATH=company_world/portal/portal.db
PORTAL_SESSION_SECRET=acme-dev-secret-change-me
# Headless admin toggles (evals/demo); manager session also works.
PORTAL_ADMIN_TOKEN=demo-admin-token

# Operator runtime
OPERATOR_DB_PATH=data/operator.db
OPERATOR_HEADLESS=true
FAULTS=
SESSION_EXPIRY_N=5

# Optional
LOG_LEVEL=INFO
