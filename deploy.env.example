# Copy to deploy.env (gitignored) and fill in. Never commit real secrets.
# Local defaults keep both services on loopback. See docs/DEPLOY.md.

# Bind address for process listen (loopback = private). Override only behind firewall/VPN.
DEPLOY_BIND_HOST=127.0.0.1
PORTAL_HOST=127.0.0.1
OPERATOR_HOST=127.0.0.1
PORTAL_PORT=8765
OPERATOR_PORT=8877

# Portal ↔ Operator (Playwright must reach portal; prefer loopback on same host)
PORTAL_BASE_URL=http://127.0.0.1:8765

# Portal credentials (required). Use strong values in any shared environment.
PORTAL_OPERATOR_PASSWORD=change-me
PORTAL_MANAGER_PASSWORD=priya-approve
PORTAL_SESSION_SECRET=acme-dev-secret-change-me
PORTAL_ADMIN_TOKEN=demo-admin-token

# Operator runtime
OPERATOR_DB_PATH=data/operator.db
OPERATOR_DATA_DIR=data
OPERATOR_HEADLESS=true
# Short demo slice for UI golden path (optional)
OPERATOR_DEMO_INVOICES=INV-1001,INV-1003,INV-1006

# Optional Anthropic key for real Haiku (FakeLLM used when unset)
# ANTHROPIC_API_KEY=
OPERATOR_MODEL=claude-haiku-5-5

# REQUIRED before exposing Operator UI beyond loopback (HTTP Basic Auth).
# Leave empty for local loopback-only demos.
OPERATOR_UI_BASIC_AUTH_USER=
OPERATOR_UI_BASIC_AUTH_PASS=

# PID / log dirs for make deploy-up / deploy-down
DEPLOY_RUN_DIR=.deploy
